{
  "name": "agent-orchestrator-bots",
  "displayName": "Agent Orchestrator Bots",
  "description": "Receive supplied-text orchestration tasks through VS Code's existing Copilot models.",
  "version": "0.1.0",
  "publisher": "local-orchestrator",
  "engines": {"vscode": "^1.95.0"},
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished", "onUri"],
  "capabilities": {"untrustedWorkspaces": {"supported": false}},
  "contributes": {
    "commands": [
      {"command": "orchestratorBots.enable", "title": "Agent Orchestrator: Enable VS Code Bots"},
      {"command": "orchestratorBots.disable", "title": "Agent Orchestrator: Disable VS Code Bots"},
      {"command": "orchestratorBots.model", "title": "Agent Orchestrator: Choose Bot Model"}
    ]
  }
}
